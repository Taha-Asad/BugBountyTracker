            R2_LIFECYCLE["Object Storage Governance<br/>(Presigned Direct Upload / Strict Quota Caps)"]
        end
        PGBOUNCER --> RLS_ENGINE
        RLS_ENGINE --> DATA_TABLES
        RLS_ENGINE --> AUDIT_LEDGER
        R2_BUCKET --> R2_LIFECYCLE
    end


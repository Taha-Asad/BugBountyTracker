        subgraph T2_SERVICES["Stateless Application Services (Node.js Serverless Functions)"]
            INTAKE_SVC["Confidential Intake Controller<br/>(Turnstile Token Verification)"]
            CVSS_ENG["CVSS v3.1 Base Scoring Engine<br/>(Deterministic Pure TypeScript)"]
            TRIAGE_SVC["Dual-Lane Triage Controller<br/>(Optimistic Concurrency & Recipient Tracking)"]
            REMED_SVC["Remediation Attestation Service<br/>(GitHub REST API v3 Integration)"]
            CRON_SVC["Hourly Scheduled Cron Worker<br/>(Ed25519-Signed JWT Authentication)"]

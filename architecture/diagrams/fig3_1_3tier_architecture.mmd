flowchart TB
    subgraph TIER1["Tier 1: Client Presentation & Cryptographic Boundary (Web Browser)"]
        direction TB
        subgraph T1_ACTORS["Actors & Intake Context"]
            ACT_H["Security Researcher<br/>(Hunter / Account-Less Guest)"]
            ACT_D["Organization Defender<br/>(Owner / Reviewer)"]

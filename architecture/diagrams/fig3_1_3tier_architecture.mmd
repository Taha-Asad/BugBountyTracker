        API_ROUTER --> AUTH_MW
        API_ROUTER --> RATE_LMT
        AUTH_MW --> INTAKE_SVC
        AUTH_MW --> TRIAGE_SVC
        AUTH_MW --> REMED_SVC
        AUTH_MW --> PRESIGN_SVC
        INTAKE_SVC --> CVSS_ENG
    end

    subgraph TIER3["Tier 3: Persistence & Object Storage Tier (Cloud Data Layer)"]

erDiagram
    CLUSTER_STORAGE_STATE ||--o{ ORGANIZATION : governs
    ORGANIZATION ||--|| ORGANIZATION_AUDIT_HEAD : anchors
    ORGANIZATION ||--o{ PROGRAM : hosts
    ORGANIZATION ||--o{ USER_MEMBERSHIP : employs
    ORGANIZATION ||--o{ PROGRAM_INVITATION : issues
    PROGRAM ||--o{ PROGRAM_DEFENDER : assigns
    PROGRAM ||--o{ SUBMISSION_SESSION : issues
    USER ||--o{ PROGRAM_DEFENDER : participates
    USER ||--o{ USER_MEMBERSHIP : belongs_to
    USER ||--o{ USER_KEY : owns
    USER ||--o{ SESSION : authenticates
    PROGRAM ||--o{ REPORT : receives
    REPORT ||--o{ REPORT_RECIPIENT : wraps_for
    REPORT ||--o{ UPLOAD_RESERVATION : reserves
    REPORT ||--o{ GUEST_MUTATION_NONCE : sequences
    REPORT ||--o{ CVSS_ASSESSMENT_HISTORY : records
    REPORT ||--o{ DISCUSSION_MESSAGE : contains
    REPORT ||--o{ REMEDIATION_RECORD : proposes
    REMEDIATION_RECORD ||--o{ RETEST_EVIDENCE : verified_by
    REPORT ||--o{ RETEST_EVIDENCE : tested_by
    REPORT ||--o{ CLOSURE_EVIDENCE_EXPORT : generates
    REPORT ||--o{ AUDIT_EVENT : tracks

    CLUSTER_STORAGE_STATE {
        int singleton_id PK
        bigint emergency_db_buffer_used_bytes "Max 20 MiB Shared Pool"
        datetime updated_at
    }

    ORGANIZATION {
        uuid id PK
        string name
        string slug UK
        string domain
        boolean domain_verified
        string plan_tier "FREE_PILOT |PRO_TEAM"
        int max_programs
        int max_seats
        bigint storage_quota_bytes
        bigint r2_used_bytes
        bigint db_ciphertext_used_bytes
        bigint db_intake_quota_bytes
        bigint db_reserve_quota_bytes
        bigint emergency_reserve_granted_bytes "Max +2 MiB Grant"
        datetime created_at
    }

    ORGANIZATION_AUDIT_HEAD {
        uuid org_id PK
        bigint last_tenant_seq_no
        string last_tenant_hash "64-char SHA-256 hex"
        datetime updated_at
    }

    PROGRAM {
        uuid id PK
        uuid organization_id FK
        string name
        string slug UK
        string visibility "PUBLIC | INVITE_ONLY"
        int recipient_set_version
        string recovery_public_key
        string policy_markdown
        datetime created_at
    }

    PROGRAM_DEFENDER {
        uuid id PK
        uuid program_id FK
        uuid user_id FK
        string role "LEAD_TRIAGER | REVIEWER"
        boolean is_active
        datetime assigned_at
    }

    PROGRAM_INVITATION {
        uuid id PK
        uuid program_id FK
        string token_hash UK
        string invitee_email
        datetime expires_at
        datetime accepted_at
    }

    SUBMISSION_SESSION {
        uuid submission_id PK
        uuid organization_id FK
        uuid program_id FK
        string status "ISSUED | CONSUMED | EXPIRED"
        string request_digest_sha256 "nullable"
        uuid report_id FK "nullable"
        string cached_response_json "OpenPGP Encrypted Guest Token"
        datetime expires_at
    }

    UPLOAD_RESERVATION {
        uuid reservation_id PK
        uuid submission_id FK
        uuid organization_id FK
        uuid report_id FK "nullable"
        string r2_object_key UK
        bigint reserved_bytes
        string status "RESERVED | ATTACHED | DELETING | DELETED | DELETE_FAILED"
        uuid claim_id "nullable 2-min Lease"
        datetime claim_expires_at "nullable"
        datetime expires_at
    }

    USER {
        uuid id PK
        string email UK
        string password_hash
        string totp_secret_cipher
        boolean mfa_enabled
        string full_name
        datetime created_at
    }

    SESSION {
        uuid id PK
        uuid user_id FK
        string token_hash UK "SHA-256 of Raw Cookie Token"
        datetime expires_at
        datetime created_at
    }

    USER_MEMBERSHIP {
        uuid id PK
        uuid organization_id FK
        uuid user_id FK
        string role "ORG_OWNER | ORG_DEFENDER | ORG_READONLY"
    }

    USER_KEY {
        uuid id PK
        uuid user_id FK
        string key_type "PRIMARY_SIGNING | ENCRYPTION_SUBKEY"
        string public_key_armor
        string encrypted_private_key_backup "Argon2id S2K Backup"
        string fingerprint UK "64-char SHA-256 hex"
        boolean is_active
        datetime created_at
    }

    REPORT {
        uuid id PK
        uuid organization_id FK
        uuid program_id FK
        uuid hunter_id FK "nullable"
        uuid guest_actor_id UK "nullable UUIDv4"
        string guest_token_hash UK "nullable SHA-256"
        string guest_public_key "nullable Curve25519"
        string guest_recovery_hash "nullable SHA-256"
        uuid assigned_defender_id FK "nullable"
        string state "15-State Lifecycle Enum"
        string operational_label "8-Category Neutral Enum"
        string title_ciphertext "Class B Ciphertext"
        string asset_scope
        string cvss_vector
        float cvss_suggested
        float cvss_score
        string encrypted_payload "Class B Ciphertext"
        string payload_body_sha256 "Immutable Content Digest"
        uuid risk_accepted_by_user_id FK "nullable"
        string risk_rationale_ciphertext "Class C Ciphertext nullable"
        datetime risk_review_date "nullable"
        int remediation_attempt_no
        boolean capacity_deadline_paused
        datetime capacity_paused_at "nullable"
        datetime sla_triage_due
        datetime sla_remediation_due
        datetime created_at
        datetime updated_at
    }

    REPORT_RECIPIENT {
        uuid id PK
        uuid report_id FK
        uuid user_id FK "nullable"
        string key_fingerprint
        string recipient_lane "CLASS_B | CLASS_C"
        string wrapped_session_key "PKESK Packet"
        datetime wrapped_at
    }

    GUEST_MUTATION_NONCE {
        uuid report_id PK
        bigint nonce PK
        string action_type
        string request_digest_sha256
        datetime consumed_at
    }

    CVSS_ASSESSMENT_HISTORY {
        uuid id PK
        uuid report_id FK
        uuid actor_user_id FK
        string previous_vector
        string new_vector
        float new_score
        string rationale_ciphertext "Class B Ciphertext"
        datetime created_at
    }

    DISCUSSION_MESSAGE {
        uuid id PK
        uuid report_id FK
        string sender_actor_type "USER | GUEST | SYSTEM"
        uuid sender_user_id FK "nullable"
        uuid sender_guest_actor_id "nullable"
        string lane "RESEARCHER_ORG | REVIEWER_INTERNAL"
        string encrypted_body "Class B or Class C Ciphertext"
        string body_sha256
        datetime created_at
    }

    REMEDIATION_RECORD {
        uuid id PK
        uuid report_id FK
        int attempt_no
        string deployment_status "PROPOSED_UNDEPLOYED | DEPLOYED_CONFIRMED"
        string evidence_type "CODE_COMMIT | CONFIG_INFRASTRUCTURE"
        string commit_sha "nullable"
        string branch_name "nullable"
        string config_hash "nullable SHA-256"
        string config_snapshot_ciphertext "Class B <= 256 KiB"
        string deployment_env
        string deployed_version
        boolean github_verified
        datetime created_at
    }

    RETEST_EVIDENCE {
        uuid id PK
        uuid report_id FK
        uuid remediation_record_id FK
        int attempt_no
        string verifier_actor_type "HUNTER | DEFENDER | TIMEOUT"
        uuid verifier_user_id FK "nullable"
        uuid verifier_guest_actor_id "nullable"
        boolean fix_confirmed
        string verification_notes_cipher "Class B Ciphertext"
        datetime retest_date
    }

    CLOSURE_EVIDENCE_EXPORT {
        uuid id PK
        uuid report_id FK
        int closure_report_seq_no "M <= K"
        string export_type "PDF | JSON"
        string export_sha256
        uuid closing_officer_id FK
        datetime generated_at
    }

    AUDIT_EVENT {
        uuid id PK
        uuid organization_id FK
        uuid report_id FK "nullable"
        bigint tenant_seq_no
        bigint report_seq_no "nullable"
        string actor_type "USER | GUEST | SYSTEM"
        uuid actor_user_id FK "nullable"
        uuid actor_guest_actor_id "nullable"
        string action
        string event_digest "64-char SHA-256 hex"
        string report_hash "nullable 64-char hex"
        string tenant_hash "64-char SHA-256 hex"
        datetime timestamp
    }
